{
  "$defs": {
    "CanonicalIdentityEnvelope": {
      "additionalProperties": false,
      "description": "Shared identity references; contract-specific IDs remain authoritative.",
      "properties": {
        "contract_kind": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Contract Kind",
          "type": "string"
        },
        "contract_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Contract Version",
          "type": "string"
        },
        "project_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Project Id",
          "type": "string"
        },
        "asset_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset Id"
        },
        "asset_version_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Asset Version Id"
        },
        "run_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Run Id",
          "type": "string"
        },
        "source_file_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source File Id"
        },
        "source_unit_id": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Unit Id"
        },
        "content_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Content Hash"
        },
        "domain_schema_version": {
          "enum": [
            "1.0",
            "2.0"
          ],
          "title": "Domain Schema Version",
          "type": "string"
        },
        "domain_contract_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Domain Contract Hash",
          "type": "string"
        },
        "semantic_contract_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Semantic Contract Hash"
        },
        "canonical_schema_version": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Canonical Schema Version",
          "type": "string"
        },
        "prompt_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Version"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Prompt Hash"
        },
        "model_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Version"
        },
        "model_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Model Hash"
        },
        "extractor_name": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extractor Name"
        },
        "extractor_version": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extractor Version"
        },
        "parent_artifact_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Artifact Ids",
          "type": "array"
        },
        "parent_record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Parent Record Ids",
          "type": "array"
        },
        "immutable_locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/ImmutableSourceLocator"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_kind",
        "project_id",
        "asset_id",
        "asset_version_id",
        "run_id",
        "source_file_id",
        "source_unit_id",
        "content_hash",
        "domain_schema_version",
        "domain_contract_hash",
        "semantic_contract_hash",
        "canonical_schema_version",
        "prompt_version",
        "prompt_hash",
        "model_version",
        "model_hash",
        "extractor_name",
        "extractor_version",
        "immutable_locator"
      ],
      "title": "CanonicalIdentityEnvelope",
      "type": "object"
    },
    "ImmutableSourceLocator": {
      "additionalProperties": false,
      "description": "Typed immutable adapter over ``build_source_locator``.",
      "properties": {
        "locator_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Locator Version",
          "type": "string"
        },
        "blob_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blob Uri"
        },
        "blob_version_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blob Version Id"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "slide": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Slide"
        },
        "section_path": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Path"
        },
        "cell_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Range"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "polygon": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sheet_zone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet Zone"
        },
        "tile_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tile Id"
        },
        "coordinate_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate System"
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/JsonValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "native_layer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Layer Id"
        },
        "native_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Object Id"
        },
        "locator_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Locator Hash",
          "type": "string"
        }
      },
      "required": [
        "locator_hash"
      ],
      "title": "ImmutableSourceLocator",
      "type": "object"
    },
    "JsonValue": {},
    "SourceCorpusEntry": {
      "additionalProperties": false,
      "properties": {
        "source_file_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Source File Id",
          "type": "string"
        },
        "asset_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_version_id": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Asset Version Id",
          "type": "string"
        },
        "original_byte_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Original Byte Hash",
          "type": "string"
        },
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "media_type": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Media Type",
          "type": "string"
        },
        "relative_source_ref": {
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Relative Source Ref",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "eligible",
            "excluded",
            "blocked"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "adapter_status": {
          "enum": [
            "supported",
            "unsupported",
            "unreadable",
            "invalid_media",
            "failed"
          ],
          "title": "Adapter Status",
          "type": "string"
        },
        "adapter_name": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adapter Name"
        },
        "reason_code": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason Code"
        }
      },
      "required": [
        "source_file_id",
        "asset_id",
        "asset_version_id",
        "original_byte_hash",
        "byte_count",
        "media_type",
        "relative_source_ref",
        "disposition",
        "adapter_status"
      ],
      "title": "SourceCorpusEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "identity": {
      "$ref": "#/$defs/CanonicalIdentityEnvelope"
    },
    "contract_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "source_corpus_manifest_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Source Corpus Manifest Id",
      "type": "string"
    },
    "inventory_scope": {
      "const": "complete",
      "default": "complete",
      "title": "Inventory Scope",
      "type": "string"
    },
    "corpus_root_id": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "title": "Corpus Root Id",
      "type": "string"
    },
    "corpus_root_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Root Hash",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SourceCorpusEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "total_entry_count": {
      "minimum": 0,
      "title": "Total Entry Count",
      "type": "integer"
    },
    "eligible_entry_count": {
      "minimum": 0,
      "title": "Eligible Entry Count",
      "type": "integer"
    },
    "excluded_entry_count": {
      "minimum": 0,
      "title": "Excluded Entry Count",
      "type": "integer"
    },
    "blocked_entry_count": {
      "minimum": 0,
      "title": "Blocked Entry Count",
      "type": "integer"
    },
    "total_byte_count": {
      "minimum": 0,
      "title": "Total Byte Count",
      "type": "integer"
    },
    "corpus_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Hash",
      "type": "string"
    }
  },
  "required": [
    "identity",
    "source_corpus_manifest_id",
    "corpus_root_id",
    "corpus_root_hash",
    "entries",
    "total_entry_count",
    "eligible_entry_count",
    "excluded_entry_count",
    "blocked_entry_count",
    "total_byte_count",
    "corpus_hash"
  ],
  "title": "SourceCorpusManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l1-source-corpus-manifest-1.0.0.schema.json"
}
