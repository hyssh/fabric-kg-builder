{
  "$defs": {
    "AmbiguousTermV2": {
      "additionalProperties": false,
      "description": "Strict ambiguous terminology for schema 2.0.",
      "properties": {
        "term": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Term",
          "type": "string"
        },
        "meanings": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Meanings",
          "type": "array"
        }
      },
      "required": [
        "term",
        "meanings"
      ],
      "title": "AmbiguousTermV2",
      "type": "object"
    },
    "ApprovalMetadataV2": {
      "additionalProperties": false,
      "description": "One-summary approval metadata for a schema-2.0 domain contract.",
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "needs_review",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At Utc"
        },
        "contract_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Hash"
        },
        "proposal_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Hash"
        },
        "source_profile_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Profile Hash"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "model_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Hash"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "ApprovalMetadataV2",
      "type": "object"
    },
    "BusinessSectionV2": {
      "additionalProperties": false,
      "description": "Strict users, decisions, and operating context for schema 2.0.",
      "properties": {
        "organization_context": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Organization Context",
          "type": "string"
        },
        "users": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Users",
          "type": "array"
        },
        "decisions": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Decisions",
          "type": "array"
        }
      },
      "required": [
        "organization_context",
        "users",
        "decisions"
      ],
      "title": "BusinessSectionV2",
      "type": "object"
    },
    "CandidateModelSectionV2": {
      "additionalProperties": false,
      "description": "Typed candidate model sealed by schema-2.0 approval.",
      "properties": {
        "entity_types": {
          "items": {
            "$ref": "#/$defs/DomainEntityTypeV2"
          },
          "minItems": 1,
          "title": "Entity Types",
          "type": "array"
        },
        "relationship_types": {
          "items": {
            "$ref": "#/$defs/DomainRelationshipTypeV2"
          },
          "minItems": 1,
          "title": "Relationship Types",
          "type": "array"
        }
      },
      "required": [
        "entity_types",
        "relationship_types"
      ],
      "title": "CandidateModelSectionV2",
      "type": "object"
    },
    "CanonicalTermV2": {
      "additionalProperties": false,
      "description": "Strict preferred terminology for schema 2.0.",
      "properties": {
        "term": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Term",
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Definition",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "CanonicalTermV2",
      "type": "object"
    },
    "CompetencyQuestionV2": {
      "additionalProperties": false,
      "description": "One stable competency question used for coverage and path design.",
      "properties": {
        "id": {
          "pattern": "^cq:[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 15,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "business_critical": {
          "default": true,
          "title": "Business Critical",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "CompetencyQuestionV2",
      "type": "object"
    },
    "ConstraintsSectionV2": {
      "additionalProperties": false,
      "description": "Strict schema-2.0 temporal, regulatory, privacy, and safety rules.",
      "properties": {
        "temporal": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Temporal",
          "type": "array"
        },
        "regulatory": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Regulatory",
          "type": "array"
        },
        "privacy": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Privacy",
          "type": "array"
        },
        "safety": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Safety",
          "type": "array"
        }
      },
      "title": "ConstraintsSectionV2",
      "type": "object"
    },
    "DomainContractV2": {
      "additionalProperties": false,
      "description": "New-project-only bounded domain design contract.",
      "properties": {
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/DomainSectionV2"
        },
        "business": {
          "$ref": "#/$defs/BusinessSectionV2"
        },
        "problem": {
          "$ref": "#/$defs/ProblemSectionV2"
        },
        "competency_questions": {
          "items": {
            "$ref": "#/$defs/CompetencyQuestionV2"
          },
          "maxItems": 10,
          "minItems": 5,
          "title": "Competency Questions",
          "type": "array"
        },
        "terminology": {
          "$ref": "#/$defs/TerminologySectionV2"
        },
        "candidate_model": {
          "$ref": "#/$defs/CandidateModelSectionV2"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintsSectionV2"
        },
        "examples": {
          "$ref": "#/$defs/ExamplesSectionV2"
        },
        "reasoning_policy": {
          "$ref": "#/$defs/ReasoningPolicyV2"
        },
        "extraction_policy": {
          "$ref": "#/$defs/ExtractionPolicyV2"
        },
        "publication_policy": {
          "$ref": "#/$defs/PublicationPolicyV2"
        },
        "question_plans": {
          "items": {
            "$ref": "#/$defs/QuestionPlanV2"
          },
          "title": "Question Plans",
          "type": "array"
        },
        "approval": {
          "$ref": "#/$defs/ApprovalMetadataV2"
        }
      },
      "required": [
        "schema_version",
        "domain",
        "business",
        "problem",
        "competency_questions",
        "terminology",
        "candidate_model",
        "constraints",
        "examples",
        "reasoning_policy",
        "question_plans"
      ],
      "title": "DomainContractV2",
      "type": "object"
    },
    "DomainEntityTypeV2": {
      "additionalProperties": false,
      "description": "One approved entity type in a schema-2.0 domain design.",
      "properties": {
        "id": {
          "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "pattern": "^proposal-evidence:[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "business_defined": {
          "default": false,
          "title": "Business Defined",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DomainEntityTypeV2",
      "type": "object"
    },
    "DomainRelationshipTypeV2": {
      "additionalProperties": false,
      "description": "One bounded, directed relationship type in a schema-2.0 design.",
      "properties": {
        "id": {
          "pattern": "^relationship-type:[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "predicate": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Predicate",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "source_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Types",
          "type": "array"
        },
        "target_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Types",
          "type": "array"
        },
        "direction": {
          "const": "source_to_target",
          "default": "source_to_target",
          "title": "Direction",
          "type": "string"
        },
        "endpoint_policy": {
          "default": "allow_subtypes",
          "enum": [
            "allow_subtypes",
            "exact"
          ],
          "title": "Endpoint Policy",
          "type": "string"
        },
        "evidence_policy": {
          "const": "exact_span_required",
          "default": "exact_span_required",
          "title": "Evidence Policy",
          "type": "string"
        },
        "publication_policy": {
          "const": "asserted_only",
          "default": "asserted_only",
          "title": "Publication Policy",
          "type": "string"
        },
        "competency_question_ids": {
          "items": {
            "type": "string"
          },
          "title": "Competency Question Ids",
          "type": "array"
        },
        "governance_rule": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governance Rule"
        },
        "source_evidence_ids": {
          "items": {
            "pattern": "^proposal-evidence:[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "predicate",
        "description",
        "source_types",
        "target_types"
      ],
      "title": "DomainRelationshipTypeV2",
      "type": "object"
    },
    "DomainSectionV2": {
      "additionalProperties": false,
      "description": "Strict domain description for schema 2.0.",
      "properties": {
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "subdomains": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Subdomains",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "DomainSectionV2",
      "type": "object"
    },
    "ExamplesSectionV2": {
      "additionalProperties": false,
      "description": "Strict representative examples for schema 2.0.",
      "properties": {
        "positive": {
          "items": {
            "$ref": "#/$defs/PositiveExampleV2"
          },
          "title": "Positive",
          "type": "array"
        },
        "negative": {
          "items": {
            "$ref": "#/$defs/NegativeExampleV2"
          },
          "title": "Negative",
          "type": "array"
        }
      },
      "title": "ExamplesSectionV2",
      "type": "object"
    },
    "ExtractionPolicyV2": {
      "additionalProperties": false,
      "description": "Closed-vocabulary and evidence requirements for schema 2.0.",
      "properties": {
        "vocabulary_mode": {
          "const": "closed",
          "default": "closed",
          "title": "Vocabulary Mode",
          "type": "string"
        },
        "exact_evidence_span_required": {
          "const": true,
          "default": true,
          "title": "Exact Evidence Span Required",
          "type": "boolean"
        },
        "abstain_without_evidence": {
          "const": true,
          "default": true,
          "title": "Abstain Without Evidence",
          "type": "boolean"
        },
        "allow_subtype_endpoints": {
          "default": true,
          "title": "Allow Subtype Endpoints",
          "type": "boolean"
        }
      },
      "title": "ExtractionPolicyV2",
      "type": "object"
    },
    "NegativeExampleV2": {
      "additionalProperties": false,
      "description": "Strict negative example for schema 2.0.",
      "properties": {
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "text",
        "reason"
      ],
      "title": "NegativeExampleV2",
      "type": "object"
    },
    "PositiveExampleV2": {
      "additionalProperties": false,
      "description": "Strict positive example for schema 2.0.",
      "properties": {
        "text": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "expected": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Expected",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "PositiveExampleV2",
      "type": "object"
    },
    "ProblemSectionV2": {
      "additionalProperties": false,
      "description": "Strict problem and scope definition for schema 2.0.",
      "properties": {
        "statement": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Statement",
          "type": "string"
        },
        "desired_outcomes": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "Desired Outcomes",
          "type": "array"
        },
        "in_scope": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "minItems": 1,
          "title": "In Scope",
          "type": "array"
        },
        "out_of_scope": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Out Of Scope",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "desired_outcomes",
        "in_scope"
      ],
      "title": "ProblemSectionV2",
      "type": "object"
    },
    "ProposalEvidence": {
      "additionalProperties": false,
      "description": "Bounded source evidence cited by candidate vocabulary.",
      "properties": {
        "id": {
          "pattern": "^proposal-evidence:[a-zA-Z0-9][a-zA-Z0-9._:-]*$",
          "title": "Id",
          "type": "string"
        },
        "source_sample_id": {
          "minLength": 1,
          "title": "Source Sample Id",
          "type": "string"
        },
        "source_file_id": {
          "minLength": 1,
          "title": "Source File Id",
          "type": "string"
        },
        "sample_kind": {
          "enum": [
            "heading",
            "text",
            "table",
            "visual_description"
          ],
          "title": "Sample Kind",
          "type": "string"
        },
        "citation": {
          "minLength": 1,
          "title": "Citation",
          "type": "string"
        },
        "locator": {
          "additionalProperties": true,
          "title": "Locator",
          "type": "object"
        },
        "excerpt": {
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_sample_id",
        "source_file_id",
        "sample_kind",
        "citation",
        "excerpt",
        "content_hash"
      ],
      "title": "ProposalEvidence",
      "type": "object"
    },
    "PublicationPolicyV2": {
      "additionalProperties": false,
      "description": "Serving lifecycle policy for schema 2.0.",
      "properties": {
        "included_states": {
          "items": {
            "const": "asserted",
            "type": "string"
          },
          "title": "Included States",
          "type": "array"
        },
        "excluded_states": {
          "items": {
            "enum": [
              "unresolved",
              "rejected"
            ],
            "type": "string"
          },
          "title": "Excluded States",
          "type": "array"
        },
        "source_table": {
          "const": "semantic_relationships",
          "default": "semantic_relationships",
          "title": "Source Table",
          "type": "string"
        }
      },
      "title": "PublicationPolicyV2",
      "type": "object"
    },
    "QuestionPathStepV2": {
      "additionalProperties": false,
      "description": "One explicitly directed hop in an approved competency path.",
      "properties": {
        "from_type": {
          "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
          "title": "From Type",
          "type": "string"
        },
        "relationship_type": {
          "pattern": "^relationship-type:[a-z0-9][a-z0-9._-]*$",
          "title": "Relationship Type",
          "type": "string"
        },
        "to_type": {
          "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
          "title": "To Type",
          "type": "string"
        },
        "traversal": {
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Traversal",
          "type": "string"
        }
      },
      "required": [
        "from_type",
        "relationship_type",
        "to_type",
        "traversal"
      ],
      "title": "QuestionPathStepV2",
      "type": "object"
    },
    "QuestionPlanV2": {
      "additionalProperties": false,
      "description": "Shortest typed path or explicit unsupported result for one question.",
      "properties": {
        "question_id": {
          "pattern": "^cq:[a-z0-9][a-z0-9._-]*$",
          "title": "Question Id",
          "type": "string"
        },
        "required_path": {
          "items": {
            "$ref": "#/$defs/QuestionPathStepV2"
          },
          "title": "Required Path",
          "type": "array"
        },
        "hop_count": {
          "maximum": 4,
          "minimum": 0,
          "title": "Hop Count",
          "type": "integer"
        },
        "covered": {
          "title": "Covered",
          "type": "boolean"
        },
        "shortest_path": {
          "const": true,
          "default": true,
          "title": "Shortest Path",
          "type": "boolean"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        }
      },
      "required": [
        "question_id",
        "hop_count",
        "covered"
      ],
      "title": "QuestionPlanV2",
      "type": "object"
    },
    "ReasoningPolicyV2": {
      "additionalProperties": false,
      "description": "Approved N and K bounds shared by design, extraction, and querying.",
      "properties": {
        "relationship_type_count": {
          "maximum": 24,
          "minimum": 1,
          "title": "Relationship Type Count",
          "type": "integer"
        },
        "recommended_relationship_type_range": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Recommended Relationship Type Range",
          "type": "array"
        },
        "max_relationship_types": {
          "const": 24,
          "default": 24,
          "title": "Max Relationship Types",
          "type": "integer"
        },
        "relationship_type_count_rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Type Count Rationale"
        },
        "max_hops": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Hops",
          "type": "integer"
        },
        "absolute_max_hops": {
          "const": 4,
          "default": 4,
          "title": "Absolute Max Hops",
          "type": "integer"
        },
        "max_hops_rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Hops Rationale"
        },
        "max_relations_per_work_unit": {
          "default": 25,
          "minimum": 1,
          "title": "Max Relations Per Work Unit",
          "type": "integer"
        }
      },
      "required": [
        "relationship_type_count",
        "max_hops"
      ],
      "title": "ReasoningPolicyV2",
      "type": "object"
    },
    "TerminologySectionV2": {
