{
  "$defs": {
    "AmbiguousTerm": {
      "additionalProperties": false,
      "description": "Ambiguous or overloaded term.",
      "properties": {
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "meanings": {
          "items": {
            "type": "string"
          },
          "title": "Meanings",
          "type": "array"
        }
      },
      "required": [
        "term"
      ],
      "title": "AmbiguousTerm",
      "type": "object"
    },
    "ApprovalMetadata": {
      "additionalProperties": false,
      "description": "Approval state stored with the domain contract.",
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "needs_review",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At Utc"
        },
        "contract_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Hash"
        },
        "schema_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schema Version"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "ApprovalMetadata",
      "type": "object"
    },
    "ApprovalMetadataV2": {
      "additionalProperties": false,
      "description": "One-summary approval metadata for a schema-2.0 domain contract.",
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "needs_review",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at_utc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At Utc"
        },
        "contract_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Hash"
        },
        "proposal_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposal Hash"
        },
        "source_profile_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Profile Hash"
        },
        "prompt_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Hash"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "model_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Version"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "title": "ApprovalMetadataV2",
      "type": "object"
    },
    "BusinessSection": {
      "additionalProperties": false,
      "description": "Business and organizational context.",
      "properties": {
        "organization_context": {
          "minLength": 1,
          "title": "Organization Context",
          "type": "string"
        },
        "users": {
          "items": {
            "type": "string"
          },
          "title": "Users",
          "type": "array"
        },
        "decisions": {
          "items": {
            "type": "string"
          },
          "title": "Decisions",
          "type": "array"
        }
      },
      "required": [
        "organization_context"
      ],
      "title": "BusinessSection",
      "type": "object"
    },
    "CandidateModelSection": {
      "additionalProperties": false,
      "description": "Candidate entity and relationship categories.",
      "properties": {
        "entity_categories": {
          "items": {
            "type": "string"
          },
          "title": "Entity Categories",
          "type": "array"
        },
        "relationship_categories": {
          "items": {
            "type": "string"
          },
          "title": "Relationship Categories",
          "type": "array"
        }
      },
      "title": "CandidateModelSection",
      "type": "object"
    },
    "CandidateModelSectionV2": {
      "additionalProperties": false,
      "description": "Typed candidate model sealed by schema-2.0 approval.",
      "properties": {
        "entity_types": {
          "items": {
            "$ref": "#/$defs/DomainEntityTypeV2"
          },
          "minItems": 1,
          "title": "Entity Types",
          "type": "array"
        },
        "relationship_types": {
          "items": {
            "$ref": "#/$defs/DomainRelationshipTypeV2"
          },
          "minItems": 1,
          "title": "Relationship Types",
          "type": "array"
        }
      },
      "required": [
        "entity_types",
        "relationship_types"
      ],
      "title": "CandidateModelSectionV2",
      "type": "object"
    },
    "CanonicalTerm": {
      "additionalProperties": false,
      "description": "Preferred business terminology.",
      "properties": {
        "term": {
          "minLength": 1,
          "title": "Term",
          "type": "string"
        },
        "definition": {
          "minLength": 1,
          "title": "Definition",
          "type": "string"
        },
        "synonyms": {
          "items": {
            "type": "string"
          },
          "title": "Synonyms",
          "type": "array"
        }
      },
      "required": [
        "term",
        "definition"
      ],
      "title": "CanonicalTerm",
      "type": "object"
    },
    "CompetencyQuestionV2": {
      "additionalProperties": false,
      "description": "One stable competency question used for coverage and path design.",
      "properties": {
        "id": {
          "pattern": "^cq:[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "question": {
          "minLength": 15,
          "title": "Question",
          "type": "string"
        },
        "business_critical": {
          "default": true,
          "title": "Business Critical",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "CompetencyQuestionV2",
      "type": "object"
    },
    "ConstraintsSection": {
      "additionalProperties": false,
      "description": "Temporal, regulatory, privacy, and safety constraints.",
      "properties": {
        "temporal": {
          "items": {
            "type": "string"
          },
          "title": "Temporal",
          "type": "array"
        },
        "regulatory": {
          "items": {
            "type": "string"
          },
          "title": "Regulatory",
          "type": "array"
        },
        "privacy": {
          "items": {
            "type": "string"
          },
          "title": "Privacy",
          "type": "array"
        },
        "safety": {
          "items": {
            "type": "string"
          },
          "title": "Safety",
          "type": "array"
        }
      },
      "title": "ConstraintsSection",
      "type": "object"
    },
    "DomainContract": {
      "additionalProperties": false,
      "description": "Approved YAML source-of-truth for domain intent.",
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/DomainSection"
        },
        "business": {
          "$ref": "#/$defs/BusinessSection"
        },
        "problem": {
          "$ref": "#/$defs/ProblemSection"
        },
        "competency_questions": {
          "items": {
            "type": "string"
          },
          "title": "Competency Questions",
          "type": "array"
        },
        "terminology": {
          "$ref": "#/$defs/TerminologySection"
        },
        "candidate_model": {
          "$ref": "#/$defs/CandidateModelSection"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintsSection"
        },
        "examples": {
          "$ref": "#/$defs/ExamplesSection"
        },
        "approval": {
          "$ref": "#/$defs/ApprovalMetadata"
        }
      },
      "required": [
        "domain",
        "business",
        "problem",
        "terminology",
        "candidate_model",
        "constraints",
        "examples"
      ],
      "title": "DomainContract",
      "type": "object"
    },
    "DomainContractV2": {
      "additionalProperties": false,
      "description": "New-project-only bounded domain design contract.",
      "properties": {
        "schema_version": {
          "const": "2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/DomainSection"
        },
        "business": {
          "$ref": "#/$defs/BusinessSection"
        },
        "problem": {
          "$ref": "#/$defs/ProblemSection"
        },
        "competency_questions": {
          "items": {
            "$ref": "#/$defs/CompetencyQuestionV2"
          },
          "maxItems": 10,
          "minItems": 5,
          "title": "Competency Questions",
          "type": "array"
        },
        "terminology": {
          "$ref": "#/$defs/TerminologySection"
        },
        "candidate_model": {
          "$ref": "#/$defs/CandidateModelSectionV2"
        },
        "constraints": {
          "$ref": "#/$defs/ConstraintsSection"
        },
        "examples": {
          "$ref": "#/$defs/ExamplesSection"
        },
        "reasoning_policy": {
          "$ref": "#/$defs/ReasoningPolicyV2"
        },
        "extraction_policy": {
          "$ref": "#/$defs/ExtractionPolicyV2"
        },
        "publication_policy": {
          "$ref": "#/$defs/PublicationPolicyV2"
        },
        "question_plans": {
          "items": {
            "$ref": "#/$defs/QuestionPlanV2"
          },
          "title": "Question Plans",
          "type": "array"
        },
        "approval": {
          "$ref": "#/$defs/ApprovalMetadataV2"
        }
      },
      "required": [
        "schema_version",
        "domain",
        "business",
        "problem",
        "competency_questions",
        "terminology",
        "candidate_model",
        "constraints",
        "examples",
        "reasoning_policy",
        "question_plans"
      ],
      "title": "DomainContractV2",
      "type": "object"
    },
    "DomainEntityTypeV2": {
      "additionalProperties": false,
      "description": "One approved entity type in a schema-2.0 domain design.",
      "properties": {
        "id": {
          "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        },
        "business_defined": {
          "default": false,
          "title": "Business Defined",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "title": "DomainEntityTypeV2",
      "type": "object"
    },
    "DomainRelationshipTypeV2": {
      "additionalProperties": false,
      "description": "One bounded, directed relationship type in a schema-2.0 design.",
      "properties": {
        "id": {
          "pattern": "^relationship-type:[a-z0-9][a-z0-9._-]*$",
          "title": "Id",
          "type": "string"
        },
        "predicate": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Predicate",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Types",
          "type": "array"
        },
        "target_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Target Types",
          "type": "array"
        },
        "direction": {
          "const": "source_to_target",
          "default": "source_to_target",
          "title": "Direction",
          "type": "string"
        },
        "endpoint_policy": {
          "default": "allow_subtypes",
          "enum": [
            "allow_subtypes",
            "exact"
          ],
          "title": "Endpoint Policy",
          "type": "string"
        },
        "evidence_policy": {
          "const": "exact_span_required",
          "default": "exact_span_required",
          "title": "Evidence Policy",
          "type": "string"
        },
        "publication_policy": {
          "const": "asserted_only",
          "default": "asserted_only",
          "title": "Publication Policy",
          "type": "string"
        },
        "competency_question_ids": {
          "items": {
            "type": "string"
          },
          "title": "Competency Question Ids",
          "type": "array"
        },
        "governance_rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Governance Rule"
        },
        "source_evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "predicate",
        "description",
        "source_types",
        "target_types"
      ],
      "title": "DomainRelationshipTypeV2",
      "type": "object"
    },
    "DomainSection": {
      "additionalProperties": false,
      "description": "Top-level domain description.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "subdomains": {
          "items": {
            "type": "string"
          },
          "title": "Subdomains",
          "type": "array"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "title": "DomainSection",
      "type": "object"
    },
    "ExamplesSection": {
      "additionalProperties": false,
      "description": "Positive and negative examples.",
      "properties": {
        "positive": {
          "items": {
            "$ref": "#/$defs/PositiveExample"
          },
          "title": "Positive",
          "type": "array"
        },
        "negative": {
          "items": {
            "$ref": "#/$defs/NegativeExample"
          },
          "title": "Negative",
          "type": "array"
        }
      },
      "title": "ExamplesSection",
      "type": "object"
    },
    "ExtractionPolicyV2": {
      "additionalProperties": false,
      "description": "Closed-vocabulary and evidence requirements for schema 2.0.",
      "properties": {
        "vocabulary_mode": {
          "const": "closed",
          "default": "closed",
          "title": "Vocabulary Mode",
          "type": "string"
        },
        "exact_evidence_span_required": {
          "const": true,
          "default": true,
          "title": "Exact Evidence Span Required",
          "type": "boolean"
        },
        "abstain_without_evidence": {
          "const": true,
          "default": true,
          "title": "Abstain Without Evidence",
          "type": "boolean"
        },
        "allow_subtype_endpoints": {
          "default": true,
          "title": "Allow Subtype Endpoints",
          "type": "boolean"
        }
      },
      "title": "ExtractionPolicyV2",
      "type": "object"
    },
    "NegativeExample": {
      "additionalProperties": false,
      "description": "Representative negative example.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "text",
        "reason"
      ],
      "title": "NegativeExample",
      "type": "object"
    },
    "PositiveExample": {
      "additionalProperties": false,
      "description": "Representative positive example.",
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "expected": {
          "items": {
            "type": "string"
          },
          "title": "Expected",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "PositiveExample",
      "type": "object"
    },
    "ProblemSection": {
      "additionalProperties": false,
      "description": "Problem statement and scoping.",
      "properties": {
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "desired_outcomes": {
          "items": {
            "type": "string"
          },
          "title": "Desired Outcomes",
          "type": "array"
        },
        "in_scope": {
          "items": {
            "type": "string"
          },
          "title": "In Scope",
          "type": "array"
        },
        "out_of_scope": {
          "items": {
            "type": "string"
          },
          "title": "Out Of Scope",
          "type": "array"
        }
      },
      "required": [
        "statement"
      ],
      "title": "ProblemSection",
      "type": "object"
    },
    "PublicationPolicyV2": {
      "additionalProperties": false,
      "description": "Serving lifecycle policy for schema 2.0.",
      "properties": {
        "included_states": {
          "items": {
            "const": "asserted",
            "type": "string"
          },
          "title": "Included States",
          "type": "array"
        },
        "excluded_states": {
          "items": {
            "enum": [
              "unresolved",
              "rejected"
            ],
            "type": "string"
          },
          "title": "Excluded States",
          "type": "array"
        },
        "source_table": {
          "const": "semantic_relationships",
          "default": "semantic_relationships",
          "title": "Source Table",
          "type": "string"
        }
      },
      "title": "PublicationPolicyV2",
      "type": "object"
    },
    "QuestionPathStepV2": {
      "additionalProperties": false,
      "description": "One explicitly directed hop in an approved competency path.",
      "properties": {
        "from_type": {
          "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
          "title": "From Type",
          "type": "string"
        },
        "relationship_type": {
          "pattern": "^relationship-type:[a-z0-9][a-z0-9._-]*$",
          "title": "Relationship Type",
          "type": "string"
        },
        "to_type": {
          "pattern": "^entity-type:[a-z0-9][a-z0-9._-]*$",
          "title": "To Type",
          "type": "string"
        },
        "traversal": {
          "enum": [
            "forward",
            "reverse"
          ],
          "title": "Traversal",
          "type": "string"
        }
      },
      "required": [
        "from_type",
        "relationship_type",
        "to_type",
        "traversal"
      ],
      "title": "QuestionPathStepV2",
      "type": "object"
    },
    "QuestionPlanV2": {
      "additionalProperties": false,
      "description": "Shortest typed path or explicit unsupported result for one question.",
      "properties": {
        "question_id": {
          "pattern": "^cq:[a-z0-9][a-z0-9._-]*$",
          "title": "Question Id",
          "type": "string"
        },
        "required_path": {
          "items": {
            "$ref": "#/$defs/QuestionPathStepV2"
          },
          "title": "Required Path",
          "type": "array"
        },
        "hop_count": {
          "maximum": 4,
          "minimum": 0,
          "title": "Hop Count",
          "type": "integer"
        },
        "covered": {
          "title": "Covered",
          "type": "boolean"
        },
        "shortest_path": {
          "const": true,
          "default": true,
          "title": "Shortest Path",
          "type": "boolean"
        },
        "unsupported_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unsupported Reason"
        }
      },
      "required": [
        "question_id",
        "hop_count",
        "covered"
      ],
      "title": "QuestionPlanV2",
      "type": "object"
    },
    "ReasoningPolicyV2": {
      "additionalProperties": false,
      "description": "Approved N and K bounds shared by design, extraction, and querying.",
      "properties": {
        "relationship_type_count": {
          "maximum": 24,
          "minimum": 1,
          "title": "Relationship Type Count",
          "type": "integer"
        },
        "recommended_relationship_type_range": {
          "items": {
            "type": "integer"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Recommended Relationship Type Range",
          "type": "array"
        },
        "max_relationship_types": {
          "const": 24,
          "default": 24,
          "title": "Max Relationship Types",
          "type": "integer"
        },
        "relationship_type_count_rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relationship Type Count Rationale"
        },
        "max_hops": {
          "maximum": 4,
          "minimum": 1,
          "title": "Max Hops",
          "type": "integer"
        },
        "absolute_max_hops": {
          "const": 4,
